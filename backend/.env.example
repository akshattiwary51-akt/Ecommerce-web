PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/shopease
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated list of allowed frontend origins.
# In development, ALL localhost ports are allowed automatically.
# Add production URL here for deployment.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Stripe (optional — payment fails gracefully if not set)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Razorpay (optional — payment fails gracefully if not set)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / SMTP (optional — order confirmation emails)
# Works with Gmail (use an App Password), Mailtrap, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ShopEase <you@gmail.com>

# Cloudinary (optional — image uploads via admin panel)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
